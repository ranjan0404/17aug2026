# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform plan files
*.tfplan
*.plan
tfplan
tfplan.json

# Terraform variable files - may contain secrets
*.tfvars
*.tfvars.json

# Exception: allow example variable files
!terraform.tfvars.example
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI configuration
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Infracost
infracost.json
infracost-output.json

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Azure / credentials / secrets
*.pem
*.key
*.crt
.env
.env.*
!.env.example

# Logs
*.log